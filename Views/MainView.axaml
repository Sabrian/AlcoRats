<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AlcoRats.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="390"
             d:DesignHeight="844"
             x:Class="AlcoRats.Views.MainView"
             x:DataType="vm:MainViewModel"
             Background="#1A1A22">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <!--
      NativeWebView sits above Avalonia in its own region, so do not put
      Avalonia overlays on top of it — they won't be visible on Android.
    -->
    <DockPanel>
        <Border DockPanel.Dock="Bottom"
                Background="#252532"
                Padding="12,10">
            <TextBlock x:Name="StatusText"
                       Text="Загрузка комнаты…"
                       Foreground="#E8E8ED"
                       FontSize="13"
                       TextWrapping="Wrap" />
        </Border>

        <NativeWebView x:Name="RoomWebView"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Stretch" />
    </DockPanel>
</UserControl>
