<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AlcoRats.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="390"
             d:DesignHeight="844"
             x:Class="AlcoRats.Views.MainView"
             x:DataType="vm:MainViewModel"
             Background="{DynamicResource AppSurfaceBrush}">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <!--
      NativeWebView sits above Avalonia in its own region, so do not put
      Avalonia overlays on top of it — they won't be visible on Android.
    -->
    <DockPanel>
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource StatusBarBackgroundBrush}"
                Padding="12,8">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock x:Name="StatusText"
                           Grid.Column="0"
                           Text="Загрузка комнаты…"
                           Foreground="{DynamicResource StatusBarForegroundBrush}"
                           FontSize="13"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0" />

                <Button x:Name="ConferenceActionButton"
                        Grid.Column="1"
                        Width="40"
                        Height="40"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        VerticalAlignment="Center"
                        ToolTip.Tip="На страницу подключения"
                        Click="OnConferenceActionClick">
                    <Viewbox Width="22" Height="22" Stretch="Uniform">
                        <Panel Width="24" Height="24">
                            <Path x:Name="HomeIcon"
                                  Stretch="None"
                                  Fill="{DynamicResource StatusBarForegroundBrush}"
                                  Data="M10,20V14H14V20H19V12H22L12,3L2,12H5V20H10Z" />
                            <Path x:Name="HangupIcon"
                                  Stretch="None"
                                  Fill="{DynamicResource HangupIconBrush}"
                                  IsVisible="False"
                                  Data="M12,9C10.4,9 8.85,9.25 7.4,9.72V12.82C7.4,13.21 7.17,13.56 6.84,13.72C5.86,14.21 4.97,14.84 4.18,15.57C4,15.75 3.75,15.86 3.48,15.86C3.2,15.86 2.95,15.75 2.77,15.57L0.29,13.08C0.11,12.91 0,12.66 0,12.38C0,12.1 0.11,11.85 0.29,11.67C3.34,8.78 7.46,7 12,7S20.66,8.78 23.71,11.67C23.89,11.85 24,12.1 24,12.38C24,12.66 23.89,12.91 23.71,13.08L21.23,15.57C21.05,15.75 20.8,15.86 20.52,15.86C20.25,15.86 20,15.75 19.82,15.57C19.03,14.84 18.14,14.21 17.16,13.72C16.83,13.56 16.6,13.21 16.6,12.82V9.72C15.15,9.25 13.6,9 12,9Z" />
                        </Panel>
                    </Viewbox>
                </Button>
            </Grid>
        </Border>

        <NativeWebView x:Name="RoomWebView"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Stretch" />
    </DockPanel>
</UserControl>
