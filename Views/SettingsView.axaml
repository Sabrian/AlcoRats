<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AlcoRats.ViewModels"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d"
             d:DesignWidth="448"
             d:DesignHeight="997"
             x:Class="AlcoRats.Views.SettingsView"
             x:DataType="vm:SettingsViewModel"
             Background="{DynamicResource AppSurfaceBrush}">

    <Design.DataContext>
        <vm:SettingsViewModel />
    </Design.DataContext>

    <DockPanel Margin="16">
        <Button x:Name="BackButton"
                DockPanel.Dock="Bottom"
                HorizontalAlignment="Right"
                Height="48"
                Margin="0,16,0,0"
                Click="OnBackClick">
            <StackPanel Orientation="Horizontal"
                        Spacing="8"
                        HorizontalAlignment="Center">
                <TextBlock Text="Назад"
                           VerticalAlignment="Center"/>
                <materialIcons:MaterialIcon Kind="ArrowRight"
                                            Width="20"
                                            Height="20" />
            </StackPanel>
        </Button>

        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16">
                <TextBlock Text="Настройки"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource StatusBarForegroundBrush}"
                           Margin="0,8,0,8" />

                <StackPanel Spacing="6">
                    <TextBlock Text="Пользователь"
                               Foreground="{DynamicResource StatusBarForegroundBrush}" />
                    <TextBox Text="{Binding Settings.User}"
                             PlaceholderText="Логин / идентификатор пользователя Jitsi" />
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="Пароль пользователя"
                               Foreground="{DynamicResource StatusBarForegroundBrush}" />
                    <TextBox Text="{Binding Settings.Password}"
                             PasswordChar="•"
                             PlaceholderText="Пароль зарегистрированного пользователя" />
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="Граватар"
                               Foreground="{DynamicResource StatusBarForegroundBrush}" />
                    <TextBox Text="{Binding Settings.Gravatar}"
                             PlaceholderText="email@example.com" />
                    <TextBlock Text="Email для аватара Gravatar в комнате Jitsi."
                               Opacity="0.65"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource StatusBarForegroundBrush}" />
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="Комната"
                               Foreground="{DynamicResource StatusBarForegroundBrush}" />
                    <TextBox Text="{Binding Settings.RoomName}"
                             PlaceholderText="AlcoRats" />
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="Пароль комнаты"
                               Foreground="{DynamicResource StatusBarForegroundBrush}" />
                    <TextBox Text="{Binding Settings.RoomPassword}"
                             PasswordChar="•"
                             PlaceholderText="Пароль защищённой комнаты Jitsi" />
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="Голос озвучки"
                               Foreground="{DynamicResource StatusBarForegroundBrush}" />
                    <ComboBox ItemsSource="{Binding TtsVoices}"
                              SelectedItem="{Binding SelectedTtsVoice}"
                              HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Title}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="При смене голоса модель скачается при следующей озвучке (~60–80 МБ)."
                               Opacity="0.65"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource StatusBarForegroundBrush}" />
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="Вход пользователя"
                               Foreground="{DynamicResource StatusBarForegroundBrush}" />
                    <TextBox Text="{Binding Settings.UserEnter}"
                             PlaceholderText="{}{User}, входит" />
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="Выход пользователя"
                               Foreground="{DynamicResource StatusBarForegroundBrush}" />
                    <TextBox Text="{Binding Settings.UserLeave}"
                             PlaceholderText="{}{User}, выходит" />
                </StackPanel>

                <CheckBox IsChecked="{Binding Settings.ToolbarAlwaysVisible}"
                          Content="Закрепить нижнюю панель Jitsi" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
