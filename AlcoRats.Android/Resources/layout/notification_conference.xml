<?xml version="1.0" encoding="utf-8"?>
<!-- Collapsed shade: 4 compact avatars + overflow "+N", tight controls. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="4dp"
    android:paddingTop="4dp"
    android:paddingEnd="2dp"
    android:paddingBottom="4dp">

    <LinearLayout
        android:id="@+id/avatar_row"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/participant1"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="2dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:id="@+id/avatar1"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/name1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:gravity="center_horizontal"
                android:maxLines="1"
                android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/participant2"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="2dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:id="@+id/avatar2"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/name2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:gravity="center_horizontal"
                android:maxLines="1"
                android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/participant3"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="2dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:id="@+id/avatar3"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/name3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:gravity="center_horizontal"
                android:maxLines="1"
                android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/participant4"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="2dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:id="@+id/avatar4"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/name4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:gravity="center_horizontal"
                android:maxLines="1"
                android:textSize="9sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/participant_count"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_participant_more"
            android:gravity="center"
            android:includeFontPadding="false"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btn_mic"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="Микрофон"
        android:padding="4dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_mic" />

    <ImageButton
        android:id="@+id/btn_cam"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="Камера"
        android:padding="4dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_cam" />

    <FrameLayout
        android:id="@+id/btn_chat_wrap"
        android:layout_width="32dp"
        android:layout_height="32dp">

        <ImageButton
            android:id="@+id/btn_chat"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Сообщения"
            android:padding="4dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_chat" />

        <TextView
            android:id="@+id/chat_badge"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_gravity="top|end"
            android:background="@drawable/bg_chat_badge"
            android:gravity="center"
            android:includeFontPadding="false"
            android:textColor="#FFFFFF"
            android:textSize="8sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>

    <ImageButton
        android:id="@+id/btn_audio"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="Устройство звука"
        android:padding="4dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_speaker" />

    <ImageButton
        android:id="@+id/btn_leave"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="Покинуть"
        android:padding="4dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_leave" />
</LinearLayout>
