<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="AppWindowBrush" Color="#0B0B0F" />
            <SolidColorBrush x:Key="AppSurfaceBrush" Color="#1A1A22" />
            <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="#040404" />
            <SolidColorBrush x:Key="StatusBarForegroundBrush" Color="#E8E8ED" />
            <SolidColorBrush x:Key="HangupIconBrush" Color="#E53935" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="AppWindowBrush" Color="#F2F2F7" />
            <SolidColorBrush x:Key="AppSurfaceBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="#F7F7FA" />
            <SolidColorBrush x:Key="StatusBarForegroundBrush" Color="#1C1B1F" />
            <SolidColorBrush x:Key="HangupIconBrush" Color="#E53935" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
