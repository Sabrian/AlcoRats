<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>23</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ApplicationId>com.alcorats.app</ApplicationId>
    <ApplicationVersion>2</ApplicationVersion>
    <ApplicationDisplayVersion>1.0.0-rc.1</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <!--
      ILLink crashes task-host on this app (Avalonia + sherpa-onnx) with
      MSB4181/MSB4027 and no real trim diagnostics. XA1030 also requires AOT
      off when PublishTrimmed is false.
    -->
    <PublishTrimmed>false</PublishTrimmed>
    <RunAOTCompilation>false</RunAOTCompilation>
    <AndroidLinkMode>None</AndroidLinkMode>
    <!-- Pixel / physical devices need arm64; x64 is for the emulator. -->
    <RuntimeIdentifiers>android-arm64;android-x64</RuntimeIdentifiers>
    <RootNamespace>AlcoRats.Android</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <AndroidResource Include="Icon.png">
      <Link>Resources\drawable\Icon.png</Link>
    </AndroidResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Android" />
    <PackageReference Include="Xamarin.AndroidX.Core.SplashScreen" />
    <PackageReference Include="Xamarin.AndroidX.Media" />
    <PackageReference Include="org.k2fsa.sherpa.onnx.runtime.android-arm64" />
    <PackageReference Include="org.k2fsa.sherpa.onnx.runtime.android-x64" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AlcoRats.csproj" />
  </ItemGroup>
</Project>
