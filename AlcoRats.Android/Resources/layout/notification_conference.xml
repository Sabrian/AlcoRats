<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="8dp">

    <LinearLayout
        android:id="@+id/avatar_row"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/participant1"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:id="@+id/avatar1"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/name1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:gravity="center_horizontal"
                android:maxLines="1"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/participant2"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:id="@+id/avatar2"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/name2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:gravity="center_horizontal"
                android:maxLines="1"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/participant3"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:id="@+id/avatar3"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/name3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:gravity="center_horizontal"
                android:maxLines="1"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/participant4"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:id="@+id/avatar4"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/name4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:gravity="center_horizontal"
                android:maxLines="1"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/participant_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:textColor="#E8E8ED"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btn_mic"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="Микрофон"
        android:padding="8dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_mic" />

    <ImageButton
        android:id="@+id/btn_cam"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="Камера"
        android:padding="8dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_cam" />

    <ImageButton
        android:id="@+id/btn_leave"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="Покинуть"
        android:padding="8dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_leave" />
</LinearLayout>
