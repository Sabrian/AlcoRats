<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AlcoRats.ViewModels"
             xmlns:views="using:AlcoRats.Views"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d"
             d:DesignWidth="390"
             d:DesignHeight="844"
             x:Class="AlcoRats.Views.MainView"
             x:DataType="vm:MainViewModel"
             Background="{DynamicResource AppSurfaceBrush}">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <!--
      NativeWebView sits above Avalonia in its own region, so do not put
      Avalonia overlays on top of it — they won't be visible on Android.
      Settings overlay hides the WebView while open.
    -->
    <Panel>
        <DockPanel x:Name="ConferencePane">
            <Border DockPanel.Dock="Bottom"
                    Background="{DynamicResource StatusBarBackgroundBrush}"
                    Padding="12,8">
                <Grid ColumnDefinitions="*,Auto">
                    <ContentControl x:Name="StatusContent"
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Margin="0,0,8,0"
                                    Foreground="{DynamicResource StatusBarForegroundBrush}"
                                    FontSize="13">
                        <TextBlock Text="Загрузка комнаты…"
                                   TextWrapping="Wrap" />
                    </ContentControl>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="4"
                                VerticalAlignment="Center">
                        <Button x:Name="ConferenceActionButton"
                                Width="40"
                                Height="40"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                ToolTip.Tip="На страницу подключения"
                                Click="OnConferenceActionClick">
                            <materialIcons:MaterialIcon Kind="Home"
                                                        Width="22"
                                                        Height="22"
                                                        Foreground="{DynamicResource StatusBarForegroundBrush}" />
                        </Button>

                        <Button x:Name="SettingsButton"
                                Width="40"
                                Height="40"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                ToolTip.Tip="Настройки"
                                Click="OnSettingsClick">
                            <materialIcons:MaterialIcon Kind="Cog"
                                                        Width="22"
                                                        Height="22"
                                                        Foreground="{DynamicResource StatusBarForegroundBrush}" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- NativeWebView is created at runtime — WebView2 crashes the XAML previewer. -->
            <Panel x:Name="WebViewHost"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Stretch">
                <Border Background="{DynamicResource AppSurfaceBrush}">
                    <TextBlock Text="Jitsi"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Opacity="0.45"
                               Foreground="{DynamicResource StatusBarForegroundBrush}" />
                </Border>
            </Panel>
        </DockPanel>

        <Border x:Name="SettingsOverlay"
                IsVisible="False"
                IsHitTestVisible="False"
                Background="{DynamicResource AppSurfaceBrush}"
                ZIndex="100">
            <views:SettingsView x:Name="SettingsPage"
                                BackRequested="OnSettingsBackRequested" />
        </Border>
    </Panel>
</UserControl>
